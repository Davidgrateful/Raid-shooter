# Session encryption key (must be at least 32 characters)
SESSION_SECRET=change_me_to_a_random_string_at_least_32_chars

# Reown Cloud project ID (required for wallet connection)
# Get one at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Treasury wallet address that receives onchain marketplace payments.
# The market stays disabled (cosmetics show "PAYMENTS LIVE SOON") until
# this is a valid 0x... address.
NEXT_PUBLIC_BASE_TREASURY=

# Which Base network the market settles on: "base" (mainnet) or
# anything else (defaults to baseSepolia testnet).
NEXT_PUBLIC_BASE_NETWORK=baseSepolia

# RPC endpoint used server-side to verify payment transactions. Defaults
# to the public Base/Base Sepolia RPC if unset; set your own for
# reliability under load.
BASE_RPC_URL=

# Upstash/Vercel KV REST credentials. Without these, the leaderboard and
# marketplace profiles fall back to in-memory storage that resets on
# every deploy/restart.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret that unlocks the dev stats endpoint at /api/admin/stats. Pick any
# long random string. While unset, the endpoint returns 503 so it can
# never be public. Read stats with ?key=<token> or an
# "Authorization: Bearer <token>" header.
ADMIN_STATS_TOKEN=
